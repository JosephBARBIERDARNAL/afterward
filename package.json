    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "~5.8.3",
    "vite": "~6.3.5"
  }
}
